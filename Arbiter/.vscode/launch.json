{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run ArbiterMain (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/ArbiterMain${env:EXE_EXT}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Main (Debug)"
        },
        {
            "name": "Run ArbiterMain (No Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/ArbiterMain${env:EXE_EXT}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "externalConsole": false,
            "MIMode": "gdb",
            "noDebug": true,
            "preLaunchTask": "Build Main (Release)"
        }
    ]
}
