{
    // VSCode Debug/Run - F5 to debug, Ctrl+F5 to run
    // Note: Set EXE_EXT=.exe on Windows, leave empty on Linux
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run BitmaskEnumTest (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test/BitmaskEnumTest${env:EXE_EXT}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/test",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Tests (Debug)"
        },
        {
            "name": "Run BitmaskEnumMain (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/BitmaskEnumMain${env:EXE_EXT}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Main (Debug)"
        },
        {
            "name": "Run BitmaskEnumMain (No Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/BitmaskEnumMain${env:EXE_EXT}",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "externalConsole": false,
            "MIMode": "gdb",
            "noDebug": true,
            "preLaunchTask": "Build Main (Release)"
        }
    ]
}
